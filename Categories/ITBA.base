filters:
  and:
    - file.hasLink("ITBA.base")
formulas:
  Untitled: ""
views:
  - type: table
    name: Materias
    groupBy:
      property: Materia
      direction: ASC
    order:
      - file.name
    sort:
      - property: Materia
        direction: ASC
      - property: file.ctime
        direction: DESC
  - type: table
    name: Table
    order:
      - file.name
      - Materia
      - Created
    sort:
      - property: Materia
        direction: ASC
